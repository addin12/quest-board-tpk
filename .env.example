# Quest Board TPK: settings read when the site is BUILT (Cloudflare Pages → Settings → Environment variables).
# Without them the site builds with demo data. Every NEXT_PUBLIC_ value ends up in the pages: none is a secret.
# The backend's own settings (D1, R2, secrets) are bindings and secrets of the Pages project: see docs/backend.md.

# Where the build fetches the real data and pictures: the site's own address and the secret build key (the same BUILD_KEY the
# backend has). Never make these NEXT_PUBLIC_: that would put the key in the pages.
TPK_API_BASE=
TPK_BUILD_KEY=

# The old Apps Script web app plus its build key (…/exec?key=<BUILD_KEY>), used only until the cutover to the Cloudflare backend.
TPK_API_URL=

# The site's address, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://quest-board-tpk.pages.dev

# Cloudflare Turnstile's public site key (the robot check on the sign-in form). Empty = no check, as in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: where players can report a listing (a form or chat link).
NEXT_PUBLIC_REPORT_URL=
