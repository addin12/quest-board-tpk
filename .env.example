# Quest Board TPK: settings read when the site is BUILT (Cloudflare Pages → Settings → Environment variables).
# Without them the site builds with demo data. Every NEXT_PUBLIC_ value ends up in the pages: none is a secret.

# The Apps Script web app plus the secret build key: …/exec?key=<BUILD_KEY> (the script logs the key when you run setup()).
# Where the build fetches the real data. Never make this NEXT_PUBLIC_: it would put the key in the pages.
TPK_API_URL=

# The site's address, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://quest-board-tpk.pages.dev

# The two Google Forms' public links (docs/forms.md).
NEXT_PUBLIC_GM_FORM_URL=
NEXT_PUBLIC_GAME_FORM_URL=

# Optional: where players can report a listing (a form or chat link).
NEXT_PUBLIC_REPORT_URL=

# The admin page: the same web app address, and the Google OAuth client id (docs/setup.md, step 3).
NEXT_PUBLIC_ADMIN_API_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
